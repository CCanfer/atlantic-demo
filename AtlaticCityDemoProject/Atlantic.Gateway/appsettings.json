{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "JwtSettings": {
    "SecretKey": "AtlanticCityPruebaTecnica2026Project",
    "Issuer": "AtlanticAuth",
    "Audience": "AtlanticGateway"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "excel-route": {
        "ClusterId": "excel-cluster",
        "AuthorizationPolicy": "RequiereToken",
        "Match": {
          "Path": "/api/excel/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7167"
          }
        }
      },
      "excel-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7096"
          }
        }
      }
    }
  }
}
